// The build, src/ into dist/: tsc emits each module's .js and .d.ts. mise run types checks the same
// sources with --noEmit. The foundation is read as a consumer reads it, through the declared
// dependency's install: its shipped .d.ts, and the ambient "*.css" declaration its ./css types
// subpath holds.
// Adapted from spike-html-packages-foundation (5dd8a58): tsconfig.json, with the types of
// spike-html-packages (c2b4a19): packages/components/tsconfig.json.
{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@jaimestill/spike-html-packages-foundation/css"],
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": false
  },
  "include": ["src"]
}
