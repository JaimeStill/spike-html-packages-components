// The browser cases' in-page modules, checked against the declarations this repository's dist/
// ships rather than the sources, which would declare the same custom elements twice. The
// foundation's sheets type as its ./css types subpath declares them, as the sources' do.
// Adapted from spike-html-packages (c2b4a19): test/browser/tsconfig.json.
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "rootDir": "../.."
  },
  "include": ["support/probe.js", "support/restyle.js"]
}
